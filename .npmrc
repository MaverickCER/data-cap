# Always attach a provenance attestation on publish, regardless of whether
# `npm publish` is invoked directly or wrapped by `changeset publish`. With
# OIDC trusted publishing (see .github/workflows/release.yml, added in the
# release-readiness phase) this is attached automatically anyway, but setting
# it here is a harmless, explicit safety net -- same rationale as env-cap's
# own .npmrc.
provenance=true
