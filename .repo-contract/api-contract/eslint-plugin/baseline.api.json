              "kind": "Reference",
              "text": "TSESLint.RuleListener",
              "canonicalReference": "@typescript-eslint/utils!RuleListener:type"
            },
            {
              "kind": "Content",
              "text": "> & {\n    name: string;\n}"
            }
          ],
