node_modules
dist
coverage
.guard-check
api-docs
# The rendered HTML API reference is generated fresh in CI's Pages deploy
# job (never committed). The Markdown API report (docs/api-report/) IS
# committed and drift-checked by `internal-package-contract tool api-report`.
docs/api
# Generated fresh in CI's Pages deploy job and never committed, like docs/api.
# internal-package-contract's scripts/benchmark/render-page.mjs builds it from
# the committed benchmarks/history/ JSON (see the deploy job in ci.yml).
docs/benchmarks

# ApiContract rewrites each target's current.* files from dist/ on every `npm run contract`.
# Only the baseline.* files are committed. Targets nest (runtime/cache/, runtime/retry/),
# so the pattern uses `**` to reach every depth.
.repo-contract/api-contract/**/current.*
benchmarks/performance-runtime/fixtures
benchmarks/performance-buildtime/fixtures
# Written on the fly by test/build/json-schema.test.ts and left behind for
# post-mortem inspection: a transient fixture project, never source.
test/build/fixtures-json-schema
*.log
.DS_Store
.env
.env.*
!.env.example
.claude
.continue
.github/copilot-instructions.md
.cursor
.windsurf
.clinerules
.cline
.aider.conf.yml
.aider
.amazonq
.roo
.roo-code
GEMINI.md
.idea
.tabnine

# Evidence-cache sidecars (`evidence-cache.ts`'s `<evidence-path>.fingerprint`)
# are a local, machine-specific cache key, never a committed golden artifact.
# See src/build/evidence-cache.ts.
*.fingerprint

# Contract tooling transient output (repo-contract / internal-package-contract).
# Anchored to root: unanchored `reports` also matched (and hid from git)
# examples/enterprise-platform/reports/, which is real example source.
.stryker-tmp
/reports

# CodeScanning's exception registry lists weaknesses in the code, so it is never committed.
.repo-contract/exceptions/code-scanning.json

# A benchmark run outside CI is a gate, not a figure: only CI's results are committed.
/.benchmark-local

# Published figures, and the files beside them that say what each figure is: generated in CI, never committed.
/docs/coverage.json
/docs/mutation.json
/docs/size.json
/docs/*-badge.json
