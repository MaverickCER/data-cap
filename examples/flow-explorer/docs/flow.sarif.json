          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/app/export.ts",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 10,
                  "startColumn": 3
                }
              }
            }
          ],
          "codeFlows": [
            {
              "threadFlows": [
                {
                  "locations": [
                    {
                      "location": {
                        "physicalLocation": {
                          "artifactLocation": {
                            "uri": "src/app/export.ts",
                            "uriBaseId": "%SRCROOT%"
                          },
                          "region": {
                            "startLine": 10,
                            "startColumn": 3
                          }
                        },
                        "message": {
                          "text": "side-effect (whole)"
                        }
                      }
                    }
                  ]
                }
              ]
            }
