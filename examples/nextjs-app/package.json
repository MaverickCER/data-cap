{
  "name": "data-cap-example-nextjs",
  "private": true,
  "type": "module",
  "description": "A minimal Next.js todo app demonstrating a real user/admin data-ownership authorization model, enforced server-side, with a client-side createData() capability documented via data-cap's own ownership/classification contract.",
  "scripts": {
    "docs": "data-cap --root . --include \"src/**\" --location src/generated/data.manifest.ts --docs docs/DATA.md --ownership docs/OWNERSHIP.md --evidence docs/data.evidence.json",
    "check": "data-cap --root . --include \"src/**\" --location src/generated/data.manifest.ts --docs docs/DATA.md --ownership docs/OWNERSHIP.md --evidence docs/data.evidence.json --check",
    "typecheck": "npm run docs && tsc --noEmit",
    "dev": "npm run docs && next dev",
    "build": "npm run docs && next build",
    "start": "next start"
  },
  "dependencies": {
    "data-cap": "file:../..",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.5.0"
  }
}
