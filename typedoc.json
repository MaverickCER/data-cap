{
  "$schema": "https://typedoc.org/schema.json",
  "extends": ["internal-package-contract/config/typedoc"],
  "entryPoints": [
    "src/core/index.ts",
    "src/runtime/index.ts",
    "src/runtime/cache.ts",
    "src/runtime/retry.ts",
    "src/node/index.ts",
    "src/evidence/index.ts",
    "src/build/index.ts",
    "src/helpers/index.ts",
    "src/eslint-plugin/index.ts"
  ],
  "out": "docs/api",
  "readme": "none",
  "intentionallyNotExported": [
    "DeepPartial",
    "CapabilityBase",
    "CapabilityGetterMethods",
    "CapabilityMutatorMethods",
    "CapabilitySubscriptionMethods"
  ]
}
